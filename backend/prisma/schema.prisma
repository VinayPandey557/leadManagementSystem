// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  hashedPassword  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  leads Lead[]
}

model Lead {
  id             String   @id @default(uuid())
  firstName      String
  lastName       String
  email          String   @unique
  phone          String?
  company        String?
  city           String?
  state          String?
  source         Source
  status         Status
  score          Int
  leadValue      Float
  lastActivityAt DateTime?
  isQualified    Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  userId String
  user User @relation(fields: [userId], references: [id])
}

enum Source {
  website
  facebook_ads
  google_ads
  referral
  events
  other
}

enum Status {
  new
  contacted
  qualified
  lost
  won
}
